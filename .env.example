# -----------------------------------------------------------------------
# Required — all environments (dev, test, CI, prod)
# -----------------------------------------------------------------------

# Standard Neon connection string. Use a DIFFERENT Neon branch per environment
# (dev/test/prod) — Neon branching is how test runs get an isolated, resettable
# database without extra tooling.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Maximum number of connections the pg.Pool will maintain.
# Keep low for serverless/Neon free-tier (default 10 is fine for dev).
DB_MAX_CONNECTIONS=10

# Application environment — controls logging verbosity and error detail.
# Allowed values: development | test | production
NODE_ENV=development

# Port the HTTP server listens on.
PORT=3000